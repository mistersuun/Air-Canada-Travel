{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icon.svg",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "schedules",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/schedules.json",
          "/data/route-network.json",
          "/data/land-110m.json"
        ]
      }
    },
    {
      "name": "places",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/data/cities.json",
          "/data/climate.json"
        ]
      }
    },
    {
      "name": "vendor",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/vendor/zxing/*.wasm",
          "/vendor/pdfjs/*.mjs"
        ]
      }
    },
    {
      "name": "dest-photos",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/img/dest/*.webp",
          "/img/dest/credits.json"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/*",
          "/apple-touch-icon.png",
          "/**/*.+(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-fonts-css",
      "urls": [
        "https://fonts.googleapis.com/**"
      ],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "30d",
        "timeout": "3s",
        "strategy": "freshness"
      }
    },
    {
      "name": "google-fonts-files",
      "urls": [
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "365d",
        "strategy": "performance"
      }
    }
  ]
}
